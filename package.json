{
  "name": "@local/grok-build-policy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Adds Grok Build working rules to the system prompt while a Grok model is selected.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
