{
  "name": "dsh-grok-build-policy",
  "version": "1.0.0",
  "type": "module",
  "description": "Adds Grok Build working rules to the system prompt while a Grok model is selected.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xunflash/grok-build-policy.git"
  },
  "homepage": "https://github.com/Xunflash/grok-build-policy#readme",
  "bugs": {
    "url": "https://github.com/Xunflash/grok-build-policy/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "grok"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
